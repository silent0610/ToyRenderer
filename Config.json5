{
    "modelPath": [
        "Models/dynamic/red_panda/scene.gltf"
    ],
    "shaderPath": [
        "BlinnPhong/Basic.Vert.spv",
        "BlinnPhong/Basic.Frag.spv"
    ],
    "pipelineType": "basic",
    "enableValidation": false,
    "camera": {
        "pos": [-0.4, 1.0, -1.0],
        "Rotation": [ -38, -24, 0.0],
        "type": "lookat",
        "flipY": true,
        "fov": 90.0,
        "znear": 0.1,
        "zfar": 50.0,
        "movementSpeed": 3.0
    },
    "light": {
        "pos": [],
        "color": []
    },
    "HBAOBase": {
        "radius": 0.3,
        "stepNum": 4,
        "dirNum": 6
    },
    "SdfConfig": {
        "WorldSize": 2.0,
        "OctreeResolution": 64, // 八叉树最细一层。挑选范围不能比它更细
        "MinSelectionResolution": 4, // 挑选八叉树最粗一层
        "MaxSelectionResolution": 32, // 挑选八叉树最细一层
        "SdfResolution":64,
        "MultiViewUsedCameraNum": 256, // 没有用了
        "MaxCameraNum": 50, // 允许的最大相机数
        "SdfMode": 1, // 1 Multiview, 0 
        "MultiViewDepthResolution": 64,
        "SampledLevel": 3,  // 最低到哪一层, 如6,5,4,3
        "MeshToSdfMode": 1, // 1 JFA, 0 Linear
        "MeshToSdfIteration": 64, // 只适用于 Linear 模式
        "MeshToSdfDistanceMode": 0, // 只有在Linear模式有效, JFA默认无符号
        "MeshToSdfQuality": 1, // 1 Ultra
        "UseSdfKind": 2, // SDFAO, 0 BruteForce, 2 Multiview, 3 JFA, 4 NGP, 5 Heat, 6 BVH(cuBQL)
        "UseRandomSelection": 0,
        "EnableHierarchicalParentQuota": 0, // 1=按八叉树父节点配额挑选, 0=旧复杂度门控
        "MaxChildrenPerParent": 1 // 同一父节点下最多选几个子相机 [1,8]
    },
    "DynamicGeometry": {
        "enable": true,
        "animationIndex": 0,
        "speed": 1.0,
        "loop": true
    }
}